<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Student portfolio showcasing education, skills and projects.">
  <title> ujjwal patel| Student Portfolio</title>

  <style>
    :root {
      color-scheme: light;
      --bg: #f5f7ff;
      --card: #ffffff;
      --text: #20243a;
      --muted: #666c82;
      --accent: #6558e8;
      --border: #e2e5f0;
      --shadow: 0 10px 35px rgba(30, 35, 80, 0.07);
    }

    body.dark {
      color-scheme: dark;
      --bg: #10111b;
      --card: #191b2a;
      --text: #f2f3ff;
      --muted: #b0b4ca;
      --accent: #a59bff;
      --border: #303247;
      --shadow: 0 10px 35px rgba(0, 0, 0, 0.18);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
      scroll-padding-top: 85px;
    }

    body {
      font-family: Arial, Helvetica, sans-serif;
      background: var(--bg);
      color: var(--text);
      line-height: 1.7;
      transition: background 0.25s, color 0.25s;
    }

    a {
      color: var(--accent);
      text-decoration: none;
    }

    a:hover {
      text-decoration: underline;
    }

    .container {
      width: min(1050px, 90%);
      margin: auto;
    }

    header {
      position: sticky;
      top: 0;
      z-index: 10;
      background: var(--card);
      border-bottom: 1px solid var(--border);
    }

    nav {
      min-height: 72px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
    }

    .logo {
      color: var(--accent);
      font-size: 1.2rem;
      font-weight: 800;
    }

    .nav-links {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 17px;
    }

    .nav-links a {
      color: var(--text);
      font-size: 0.9rem;
    }

    button, .button {
      background: var(--accent);
      color: white;
      border: none;
      border-radius: 9px;
      padding: 11px 17px;
      font-weight: 700;
      cursor: pointer;
      display: inline-block;
    }

    .theme-button {
      background: var(--bg);
      color: var(--text);
      border: 1px solid var(--border);
      padding: 8px 12px;
    }

    section {
      padding: 75px 0;
    }

    .hero {
      min-height: 420px;
      display: flex;
      align-items: center;
      background:
        radial-gradient(ellipse at top right,
        rgba(101, 88, 232, 0.16), transparent 55%);
    }

    .eyebrow {
      color: var(--accent);
      font-weight: 700;
      letter-spacing: 2px;
      text-transform: uppercase;
      font-size: 0.82rem;
    }

    h1 {
      font-size: clamp(2.5rem, 7vw, 4.5rem);
      line-height: 1.12;
      margin: 14px 0;
    }

    h1 span, h2 span {
      color: var(--accent);
    }

    .hero p, .section-intro {
      max-width: 650px;
      color: var(--muted);
      margin: 16px 0 25px;
    }

    .actions {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
    }

    .button.secondary {
      color: var(--text);
      background: var(--card);
      border: 1px solid var(--border);
    }

    h2 {
      font-size: clamp(1.8rem, 4vw, 2.5rem);
      margin-bottom: 12px;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 20px;
      margin-top: 28px;
    }

    .card {
      background: var(--card);
      border: 1px solid var(--border);
      padding: 25px;
      border-radius: 16px;
      box-shadow: var(--shadow);
    }

    .card h3 {
      margin-bottom: 9px;
    }

    .card p {
      color: var(--muted);
    }

    .tags {
      display: flex;
      flex-wrap: wrap;
      gap: 9px;
      margin-top: 17px;
    }

    .tag {
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: 30px;
      padding: 5px 12px;
      font-size: 0.85rem;
    }

    .project-links {
      display: flex;
      gap: 16px;
      flex-wrap: wrap;
      margin-top: 16px;
      font-weight: 700;
    }

    .contact-card {
      text-align: center;
    }

    .contact-card p {
      margin: 12px auto 22px;
    }

    footer {
      text-align: center;
      padding: 25px 0;
      border-top: 1px solid var(--border);
      color: var(--muted);
    }

    @media (max-width: 650px) {
      nav {
        padding: 14px 0;
        align-items: flex-start;
        flex-direction: column;
      }

      .nav-links {
        gap: 12px;
      }

      .grid {
        grid-template-columns: 1fr;
      }

      section {
        padding: 55px 0;
      }

      .hero {
        min-height: 380px;
      }
    }
  </style>
</head>

<body>
  <header>
    <nav class="container">
      <a class="logo" href="#home">MyPortfolio.</a>

      <div class="nav-links">
        <a href="#about">About</a>
        <a href="#education">Education</a>
        <a href="#skills">Skills</a>
        <a href="#projects">Projects</a>
        <a href="#contact">Contact</a>
        <button class="theme-button" id="themeToggle"
          type="button" aria-label="Switch color theme">
           Dark
        </button>
      </div>
    </nav>
  </header>

  <main>
    <section class="hero" id="home">
      <div class="container">
        <p class="eyebrow">Welcome to my portfolio</p>

        <h1>Hi, I'm <span>Your Name</span></h1>

        <h3>A Student & Aspiring Developer</h3>

        <p>
          I am a student who enjoys learning new technologies,
          solving problems and building useful projects.
          Welcome to my personal portfolio!
        </p>

        <div class="actions">
          <a class="button" href="#projects">Explore My Projects</a>
          <a class="button secondary" href="#contact">Contact Me</a>
        </div>
      </div>
    </section>

    <section id="about">
      <div class="container">
        <p class="eyebrow">Get to know me</p>
        <h2>About <span>Me</span></h2>

        <p class="section-intro">
          I am a motivated student interested in technology
          and software development. I am currently improving
          my coding skills and working on practical projects.
          My goal is to learn continuously and create useful
          digital experiences.
        </p>
      </div>
    </section>

    <section id="education">
      <div class="container">
        <p class="eyebrow">My learning journey</p>
        <h2>My <span>Education</span></h2>

        <div class="grid">
          <article class="card">
            <h3>bsc (computer science) / Course</h3>
            <p>acropolic institute of managnment studies and reasearch</p>
            <p>Year: 20XX – Present</p>
          </article>

          <article class="card">
            <h3>My Learning Goals</h3>
            <p>
              Learn programming, improve problem-solving
              skills and build real-world projects.
            </p>
          </article>
        </div>
      </div>
    </section>

    <section id="skills">
      <div class="container">
        <p class="eyebrow">What I am learning</p>
        <h2>My <span>Skills</span></h2>

        <p class="section-intro">
          These are my current learning areas. I will keep
          updating this section as I gain experience.
        </p>

        <div class="tags">
          <span class="tag">HTML</span>
          <span class="tag">CSS</span>
          <span class="tag">JavaScript Basics</span>
          <span class="tag">Python Basics</span>
          <span class="tag">GitHub</span>
          <span class="tag">Problem Solving</span>
        </div>
      </div>
    </section>

    <section id="projects">
      <div class="container">
        <p class="eyebrow">Things I have built</p>
        <h2>My <span>Projects</span></h2>

        <p class="section-intro">
          Here are sample project ideas. Replace these cards
          with your real projects as you complete them.
        </p>

        <div class="grid">
          <article class="card">
            <h3>Personal Portfolio</h3>
            <p>
              A responsive personal website made with HTML,
              CSS and JavaScript.
            </p>
            <div class="tags">
              <span class="tag">HTML</span>
              <span class="tag">CSS</span>
              <span class="tag">JavaScript</span>
            </div>
            <div class="project-links">
              <a href="#home">Live Demo</a>
              <a href="https://github.com/">GitHub</a>
            </div>
          </article>

          <article class="card">
            <h3>Python Mini Project</h3>
            <p>
              A beginner-friendly Python program that solves
              a simple everyday problem.
            </p>
            <div class="tags">
              <span class="tag">Python</span>
              <span class="tag">Logic</span>
            </div>
            <div class="project-links">
              <a href="https://github.com/">View on GitHub</a>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section id="contact">
      <div class="container">
        <div class="card contact-card">
          <p class="eyebrow">Let's connect</p>
          <h2>Contact <span>Me</span></h2>

          <p>
            Have a question or want to discuss a project?
            Feel free to connect with me.
          </p>

          <div class="actions" style="justify-content:center">
            <a class="button" id="emailLink"
              href="mailto:your.email@example.com">
              Email Me
            </a>

            <a class="button secondary"
              href="https://github.com/"
              target="_blank" rel="noopener noreferrer">
              GitHub Profile
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer>
    <div class="container">
      <p>© <span id="year"></span> Your Name.
        Built with HTML, CSS & JavaScript.</p>
    </div>
  </footer>

  <script>
    const themeToggle = document.getElementById("themeToggle");

    function updateThemeButton() {
      const isDark = document.body.classList.contains("dark");
      themeToggle.textContent = isDark ? " Light" : " Dark";
      themeToggle.setAttribute(
        "aria-label",
        isDark ? "Switch to light theme" : "Switch to dark theme"
      );
    }

    themeToggle.addEventListener("click", function () {
      document.body.classList.toggle("dark");

      const theme = document.body.classList.contains("dark")
        ? "dark"
        : "light";

      try {
        localStorage.setItem("portfolio-theme", theme);
      } catch (error) {
        // Theme switching still works if storage is unavailable.
      }

      updateThemeButton();
    });

    try {
      if (localStorage.getItem("portfolio-theme") === "dark") {
        document.body.classList.add("dark");
      }
    } catch (error) {
      // Use the default light theme.
    }

    updateThemeButton();

    document.getElementById("year").textContent =
      new Date().getFullYear();
  </script>
</body>
</html>
